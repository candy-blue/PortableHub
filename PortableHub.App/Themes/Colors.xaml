<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent 2 Color Definitions (Default Dark, switches dynamically with ThemeService) -->
    <!-- Dark Palette: Window #202020, Card #2B2B2B, Secondary #252525, Text #FFFFFF, SecText #BDBDBD, Border #3A3A3A -->
    <Color x:Key="AppBackground">#202020</Color>
    <Color x:Key="AppSurface">#2B2B2B</Color>
    <Color x:Key="AppCard">#2B2B2B</Color>
    <Color x:Key="AppCardHover">#333333</Color>
    <Color x:Key="AppSecondaryBackground">#252525</Color>
    <Color x:Key="AppBorder">#3A3A3A</Color>
    <Color x:Key="AppTextPrimary">#FFFFFF</Color>
    <Color x:Key="AppTextSecondary">#BDBDBD</Color>
    <Color x:Key="AppTextTertiary">#707070</Color>
    <Color x:Key="AppAccent">#0078D4</Color>
    <Color x:Key="AppAccentHover">#187BD1</Color>
    <Color x:Key="AppDanger">#C42B1C</Color>
    <Color x:Key="AppSuccess">#107C41</Color>
    <Color x:Key="AppInputBg">#1E1E1E</Color>
    <Color x:Key="AppSidebarBg">#181818</Color>
    <Color x:Key="AppBadgeBg">#333333</Color>

    <!-- Standard Corner Radii (Design Doc Section 9: 10/8/6/8/8/12) -->
    <CornerRadius x:Key="CornerRadiusWindow">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusDialog">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSearchBox">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusContextMenu">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusButton">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusBadge">4</CornerRadius>

    <!-- Standard Spacing System (Design Doc Section 91: 4/8/12/16/20/24/32) -->
    <Thickness x:Key="SpacingTiny">4</Thickness>
    <Thickness x:Key="SpacingSmall">8</Thickness>
    <Thickness x:Key="SpacingMedium">12</Thickness>
    <Thickness x:Key="SpacingBase">16</Thickness>
    <Thickness x:Key="SpacingLarge">20</Thickness>
    <Thickness x:Key="SpacingXLarge">24</Thickness>
    <Thickness x:Key="SpacingHuge">32</Thickness>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:helpers="clr-namespace:PortableHub.App.Helpers">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Spacing.xaml" />
        <ResourceDictionary Source="IconStyles.xaml" />
        <ResourceDictionary Source="ControlStyles.xaml" />
        <ResourceDictionary Source="CardStyles.xaml" />
        <ResourceDictionary Source="NavigationStyles.xaml" />
        <ResourceDictionary Source="DialogStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Client-area TitleBarControl style to eliminate duplicate caption buttons and ghosting -->
    <Style TargetType="{x:Type ui:TitleBarControl}">
        <Setter Property="helpers:TitleBarHelper.RemoveCaptionButtons" Value="True" />
    </Style>

    <!-- Backward Compatibility Anchor -->
    <Style x:Key="_CompatibilityStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>

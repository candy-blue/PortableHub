<Window x:Class="PortableHub.App.Views.QuickLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Width="680"
        SizeToContent="Height"
        MinHeight="180"
        MaxHeight="500"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Border x:Name="RootBorder" 
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
            BorderThickness="1" 
            CornerRadius="12"
            Margin="10"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.30" Color="#000000" />
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Input (WPF-UI AutoSuggestBox style) -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <ui:TextBox x:Name="SearchBox"
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="输入软件名称、分类或标签..."
                            Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True"
                            FontSize="15"
                            Height="46"
                            VerticalContentAlignment="Center" />
            </Grid>

            <!-- Results List -->
            <ListBox Grid.Row="1"
                     x:Name="ResultsListBox"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="360"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="10,8" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Margin="0,0,12,0">
                                <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}}" Width="28" Height="28" Stretch="Uniform" />
                            </Border>

                            <!-- Name & Category -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ExePath}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Launch Hint -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="Enter" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="启动" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom shortcuts info bar with WinUI 3 keycap badges -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                        <TextBlock Text="↑ ↓" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="切换" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                        <TextBlock Text="Enter" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="启动" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                        <TextBlock Text="Ctrl + 1..9" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="直达" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                        <TextBlock Text="Esc" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="关闭" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

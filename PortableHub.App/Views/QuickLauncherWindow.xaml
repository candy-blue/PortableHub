<Window x:Class="PortableHub.App.Views.QuickLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Width="680"
        SizeToContent="Height"
        MinHeight="180"
        MaxHeight="500"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Border x:Name="RootBorder" 
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
            BorderThickness="1" 
            CornerRadius="{DynamicResource CornerRadiusDialog}"
            Margin="10"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.30" Color="#000000" />
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Input -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         ui:ControlHelper.PlaceholderText="输入软件名称、分类或标签..."
                         FontSize="16"
                         Height="48"
                         Padding="40,0,12,0"
                         VerticalContentAlignment="Center" />
                <ui:SymbolIcon Symbol="Find" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
            </Grid>

            <!-- Results List -->
            <ListBox Grid.Row="1"
                     x:Name="ResultsListBox"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="360"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" MinHeight="60" Padding="10,8" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon (40x40 container, 32x32 icon) -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Margin="0,0,12,0">
                                <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}}" Width="32" Height="32" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True" />
                            </Border>

                            <!-- Name & Category -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ExePath}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Launch Hint -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                    <TextBlock Text="Enter" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="启动" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom shortcuts info bar with WinUI 3 keycap badges -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,4,0">
                        <TextBlock Text="↑ ↓" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="切换" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,4,0">
                        <TextBlock Text="Enter" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="启动" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,4,0">
                        <TextBlock Text="Ctrl + 1..9" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="直达" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,4,0">
                        <TextBlock Text="Esc" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="关闭" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

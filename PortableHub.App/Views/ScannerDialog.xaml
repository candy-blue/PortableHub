<Window x:Class="PortableHub.App.Views.ScannerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="扫描便携软件目录" 
        Height="580" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="扫描发现便携软件" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Directory selector and Scan Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBox}" Height="36" VerticalContentAlignment="Center" />
            <Button Grid.Row="0" Grid.Column="1" Content="浏览目录..." Style="{StaticResource ModernButton}" 
                    Command="{Binding BrowseDirectoryCommand}" Margin="8,0,0,0" Height="36" />
            <Button Grid.Row="0" Grid.Column="2" Content="开始扫描" Style="{StaticResource PrimaryButton}" 
                    Command="{Binding StartScanCommand}" Margin="8,0,0,0" Height="36" Width="90" 
                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}" />

            <!-- Progress & Status -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                <ProgressBar Height="4" Value="{Binding ProgressPercentage}" 
                             Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- Results List -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="8" Padding="6">
            <ListBox ItemsSource="{Binding Candidates}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DeducedName}" FontWeight="SemiBold" FontSize="14" />
                                        <Border Background="{DynamicResource BrushBorder}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding DeducedCategory}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ExePath}" FontSize="11" Foreground="{DynamicResource BrushTextTertiary}" 
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding FileDescription}" FontSize="12" 
                                           Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="全选" Style="{StaticResource ModernButton}" Command="{Binding SelectAllCommand}" Padding="10,5" />
                <Button Content="全不选" Style="{StaticResource ModernButton}" Command="{Binding UnselectAllCommand}" Padding="10,5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource ModernButton}" Command="{Binding CancelScanCommand}" Width="80" />
                <Button Content="添加选中项" Style="{StaticResource PrimaryButton}" Command="{Binding AddSelectedCommand}" Width="110" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<ui:FluentWindow x:Class="PortableHub.App.Views.ScannerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="扫描发现便携软件" 
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        Height="620" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowCornerPreference="Round"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="扫描发现便携软件 - Portable Hub" Height="44" FontSize="18" FontWeight="SemiBold" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/PortableHub.App;component/Assets/app.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="24,14,24,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Directory selector and Scan Controls -->
            <ui:Card Grid.Row="0" Margin="0,0,0,14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Row="0" Grid.Column="0" Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="请选择或输入要扫描的 Portable 软件根目录 (如 D:\Portable)" Height="36" VerticalContentAlignment="Center" />
                    <ui:Button Grid.Row="0" Grid.Column="1" Appearance="Secondary" 
                               Command="{Binding BrowseDirectoryCommand}" Margin="8,0,0,0" Height="36" Padding="12,0" VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="浏览目录..." VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Grid.Row="0" Grid.Column="2" Appearance="Primary" Foreground="#FFFFFF" FontWeight="SemiBold"
                               Command="{Binding StartScanCommand}" Margin="8,0,0,0" Height="36" Padding="14,0" VerticalContentAlignment="Center"
                               IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Play24" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="开始扫描" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Progress & Status -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <ProgressBar Height="4" Value="{Binding ProgressPercentage}" 
                                     Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Results List -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
                <ListBox ItemsSource="{Binding Candidates}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DeducedName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Border Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding DeducedCategory}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExePath}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding FileDescription}" FontSize="12" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:Button Appearance="Secondary" Content="全选" Command="{Binding SelectAllCommand}" Height="36" Padding="14,0" Margin="0,0,8,0" FontSize="14" />
                    <ui:Button Appearance="Secondary" Content="全不选" Command="{Binding UnselectAllCommand}" Height="36" Padding="14,0" FontSize="14" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Secondary" Content="取消" Command="{Binding CancelScanCommand}" Width="80" Height="36" Margin="0,0,8,0" FontSize="14" />
                    <ui:Button Appearance="Primary" Foreground="#FFFFFF" FontWeight="SemiBold" Content="添加选中软件" Command="{Binding AddSelectedCommand}" Height="36" Padding="16,0" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

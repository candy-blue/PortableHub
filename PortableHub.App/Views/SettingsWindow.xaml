<Window x:Class="PortableHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="系统设置 - Portable Hub" 
        Height="640" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Settings Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource BrushAccent}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" FontSize="16" Foreground="#FFFFFF" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="配置 Portable Hub 的外观、行为与数据存储" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- 1. 外观 -->
            <TabItem FontSize="13" Padding="12,8">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" Style="{StaticResource FluentIcon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="外观与个性化" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,16,6,10">
                        <!-- Theme Card -->
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="应用主题" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="选择 Portable Hub 界面色彩模式" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="跟随系统" IsChecked="{Binding Theme, Converter={StaticResource ComparisonConverter}, ConverterParameter=System}" GroupName="ThemeGroup" />
                                    <RadioButton Content="浅色模式" IsChecked="{Binding Theme, Converter={StaticResource ComparisonConverter}, ConverterParameter=Light}" GroupName="ThemeGroup" Margin="16,0,0,0" />
                                    <RadioButton Content="深色模式" IsChecked="{Binding Theme, Converter={StaticResource ComparisonConverter}, ConverterParameter=Dark}" GroupName="ThemeGroup" Margin="16,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card Size Card -->
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="软件卡片尺寸" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="根据屏幕分辨率和软件数量调整卡片尺寸" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="小 (紧凑)" IsChecked="{Binding CardSize, Converter={StaticResource ComparisonConverter}, ConverterParameter=Small}" GroupName="CardSizeGroup" />
                                    <RadioButton Content="中 (推荐)" IsChecked="{Binding CardSize, Converter={StaticResource ComparisonConverter}, ConverterParameter=Medium}" GroupName="CardSizeGroup" Margin="16,0,0,0" />
                                    <RadioButton Content="大 (醒目)" IsChecked="{Binding CardSize, Converter={StaticResource ComparisonConverter}, ConverterParameter=Large}" GroupName="CardSizeGroup" Margin="16,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. 启动与托盘 -->
            <TabItem FontSize="13" Padding="12,8">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource FluentIcon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="启动与托盘" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,16,6,10">
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="随 Windows 开机启动" IsChecked="{Binding StartWithWindows}" />
                                <CheckBox Content="开机启动后自动最小化到系统托盘" IsChecked="{Binding StartMinimizedToTray}" Margin="28,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <CheckBox Content="点击窗口关闭按钮 (X) 时最小化到托盘而非退出" IsChecked="{Binding CloseToTray}" />
                                <CheckBox Content="窗口最小化时隐藏任务栏图标并缩入托盘" IsChecked="{Binding MinimizeToTray}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. 快捷键 -->
            <TabItem FontSize="13" Padding="12,8">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" Style="{StaticResource FluentIcon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="全局快捷键" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,16,6,10">
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,16">
                            <StackPanel>
                                <TextBlock Text="快速启动窗口呼出快捷键" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="无论当前在任何程序中，按下此按键立即在光标屏幕中央呼出搜索窗口" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding GlobalHotkey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="34" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding HotkeyStatus}" FontSize="12" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>

                                <TextBlock Text="支持组合键如：Ctrl+Alt+Space, Ctrl+Shift+Space, Alt+Space 等。系统自动检测冲突并阻断非法保存。" 
                                           FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. 数据与备份 -->
            <TabItem FontSize="13" Padding="12,8">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B9;" Style="{StaticResource FluentIcon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="数据与备份" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,16,6,10">
                        <!-- Data Directory -->
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="数据存储目录" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="SQLite 数据库、设置与图标缓存存放路径" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" Height="34" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="打开目录" Style="{StaticResource ModernButton}" Command="{Binding OpenDataDirectoryCommand}" Margin="8,0,0,0" Height="34" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Auto Backup Settings -->
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="自动定时备份 (.phbackup)" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="无需联网，自动在本地打包安全快照" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,12" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="备份周期:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding BackupFrequency, Mode=TwoWay}" SelectedValuePath="Tag" Height="32">
                                        <ComboBoxItem Content="每周 (推荐)" Tag="Weekly" />
                                        <ComboBoxItem Content="每天" Tag="Daily" />
                                        <ComboBoxItem Content="每月" Tag="Monthly" />
                                        <ComboBoxItem Content="关闭" Tag="Off" />
                                    </ComboBox>

                                    <TextBlock Grid.Column="3" Text="最多保留份数:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBox Grid.Column="4" Text="{Binding MaxBackupCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="立即创建备份" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" Height="32" />
                                    <Button Content="从备份文件恢复..." Style="{StaticResource ModernButton}" Command="{Binding RestoreBackupCommand}" Margin="10,0,0,0" Height="32" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backups List -->
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="现有备份记录" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Height="130">
                                    <ListBox ItemsSource="{Binding ExistingBackups}" Background="Transparent" BorderThickness="0" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5. 根目录管理 -->
            <TabItem FontSize="13" Padding="12,8">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource FluentIcon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="根目录管理" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,16,6,10">
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="便携软件根目录" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="添加 Portable 软件主文件夹，用于多盘迁移自动重连与相对路径支持" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>
                                    <Button Content="+ 添加根目录" Style="{StaticResource PrimaryButton}" Command="{Binding AddRootDirectoryCommand}" HorizontalAlignment="Right" Height="32" />
                                </Grid>

                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Height="220">
                                    <ListBox ItemsSource="{Binding RootDirectories}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="移除" Style="{StaticResource ModernButton}" 
                                                            Command="{Binding DataContext.DeleteRootDirectoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Padding="8,3" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6. 导入导出 & 诊断 -->
            <TabItem FontSize="13" Padding="12,8">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource FluentIcon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="迁移与诊断" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,16,6,10">
                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="JSON 数据交换" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="支持跨电脑、跨操作系统版本快速导出与导入软件清单" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导出软件列表为 JSON..." Style="{StaticResource ModernButton}" Command="{Binding ExportJsonCommand}" Height="32" />
                                    <Button Content="从 JSON 文件导入..." Style="{StaticResource ModernButton}" Command="{Binding ImportJsonCommand}" Margin="10,0,0,0" Height="32" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="故障排除与日志" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="查看 Serilog 运行日志与软件崩溃诊断信息" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,12" />
                                <Button Content="打开日志文件夹" Style="{StaticResource ModernButton}" Command="{Binding OpenLogsDirectoryCommand}" HorizontalAlignment="Left" Height="32" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存并退出" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndCloseCommand}" Width="100" Height="34" />
        </StackPanel>
    </Grid>
</Window>

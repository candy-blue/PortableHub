<Window x:Class="PortableHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="设置 - Portable Hub" 
        Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="系统设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- 1. 外观 -->
            <TabItem Header="外观与个性化" FontSize="13" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <StackPanel>
                            <TextBlock Text="界面主题" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="跟随系统" IsChecked="{Binding Theme, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=True}"
                                             GroupName="ThemeGroup" Command="{Binding DataContext.OnThemeChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="System" />
                                <RadioButton Content="浅色模式" GroupName="ThemeGroup" />
                                <RadioButton Content="深色模式" GroupName="ThemeGroup" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="软件卡片尺寸" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="小 (紧凑)" GroupName="CardSizeGroup" />
                                <RadioButton Content="中 (推荐)" GroupName="CardSizeGroup" IsChecked="True" />
                                <RadioButton Content="大 (醒目)" GroupName="CardSizeGroup" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. 启动与托盘 -->
            <TabItem Header="启动与托盘" FontSize="13" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <CheckBox Content="开机启动 (随 Windows 启动)" IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Content="开机启动后自动最小化到系统托盘" IsChecked="{Binding StartMinimizedToTray}" Margin="20,0,0,0" />
                        <CheckBox Content="点击窗口关闭按钮 (X) 时最小化到托盘而非退出" IsChecked="{Binding CloseToTray}" />
                        <CheckBox Content="最小化时隐藏到系统托盘" IsChecked="{Binding MinimizeToTray}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. 快捷键 -->
            <TabItem Header="全局快捷键" FontSize="13" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <TextBlock Text="快速启动窗口唤出快捷键" FontWeight="SemiBold" FontSize="14" />
                        <TextBox Text="{Binding GlobalHotkey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Width="260" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding HotkeyStatus}" FontSize="12" Foreground="{DynamicResource BrushSuccess}" />
                        <TextBlock Text="支持格式：Ctrl+Alt+Space, Ctrl+Shift+Space, Alt+Space 等。修改后保存立即生效。" 
                                   FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. 数据与备份 -->
            <TabItem Header="数据与备份" FontSize="13" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <StackPanel>
                            <TextBlock Text="数据存储目录" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" />
                                <Button Grid.Column="1" Content="打开目录" Style="{StaticResource ModernButton}" Command="{Binding OpenDataDirectoryCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="备份管理 (.phbackup)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="立即创建备份" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" />
                                <Button Content="从备份恢复..." Style="{StaticResource ModernButton}" Command="{Binding RestoreBackupCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="本地备份记录" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,6" />
                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Height="140">
                                <ListBox ItemsSource="{Binding ExistingBackups}" Background="Transparent" BorderThickness="0" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5. 根目录管理 -->
            <TabItem Header="根目录管理" FontSize="13" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <Grid>
                            <TextBlock Text="便携软件根目录列表 (用于相对路径与自动重连)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Button Content="+ 添加根目录" Style="{StaticResource PrimaryButton}" Command="{Binding AddRootDirectoryCommand}" HorizontalAlignment="Right" />
                        </Grid>

                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Height="200">
                            <ListBox ItemsSource="{Binding RootDirectories}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="删除" Style="{StaticResource ModernButton}" 
                                                    Command="{Binding DataContext.DeleteRootDirectoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="8,3" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6. 导入导出 & 诊断 -->
            <TabItem Header="数据迁移与关于" FontSize="13" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <StackPanel>
                            <TextBlock Text="JSON 数据导入导出" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="导出软件列表为 JSON" Style="{StaticResource ModernButton}" Command="{Binding ExportJsonCommand}" />
                                <Button Content="从 JSON 导入软件列表" Style="{StaticResource ModernButton}" Command="{Binding ImportJsonCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="系统诊断" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <Button Content="打开日志文件夹" Style="{StaticResource ModernButton}" Command="{Binding OpenLogsDirectoryCommand}" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Portable Hub v1.0.0" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="Windows 平台轻量级便携软件管理器" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存并退出" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndCloseCommand}" Width="100" />
        </StackPanel>
    </Grid>
</Window>

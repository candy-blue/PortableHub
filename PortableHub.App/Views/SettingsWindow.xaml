<Window x:Class="PortableHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        xmlns:helpers="clr-namespace:PortableHub.App.Helpers"
        Title="{DynamicResource Loc_Settings_Title}" 
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        Height="700" Width="960"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modern TitleBar (Standardized Fluent TitleBar with high contrast header) -->
        <ui:TitleBarControl x:Name="AppTitleBar" Grid.Row="0" Title="{DynamicResource Loc_Settings_Title}" Height="44" FontSize="20" FontWeight="SemiBold" Icon="pack://application:,,,/PortableHub.App;component/Assets/app.png" IsIconVisible="True"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            helpers:TitleBarHelper.RemoveCaptionButtons="True" />

        <!-- Main Settings Content (Windows 11 Left Navigation + Right Content Area) -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Menu -->
            <Grid Grid.Column="0" Margin="16,10,0,10">
                <ListBox x:Name="SettingsNavListBox"
                         SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SettingsNavListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!-- 1. 外观与个性化 -->
                    <ListBoxItem>
                        <Grid Height="42" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="FontColor" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Settings_Appearance}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </ListBoxItem>
                    <!-- 2. 启动与托盘 -->
                    <ListBoxItem>
                        <Grid Height="42" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="AllApps" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Settings_Startup}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </ListBoxItem>
                    <!-- 3. 全局快捷键 -->
                    <ListBoxItem>
                        <Grid Height="42" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Keyboard" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Settings_Hotkeys}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </ListBoxItem>
                    <!-- 4. 数据与备份 -->
                    <ListBoxItem>
                        <Grid Height="42" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Library" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Settings_Data}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </ListBoxItem>
                    <!-- 5. 根目录管理 -->
                    <ListBoxItem>
                        <Grid Height="42" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="OpenFile" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Settings_Roots}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </ListBoxItem>
                    <!-- 6. 迁移与诊断 -->
                    <ListBoxItem>
                        <Grid Height="42" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Sync" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Settings_Diagnostics}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <Rectangle HorizontalAlignment="Right" Width="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,-8,0" />
            </Grid>

            <!-- Right Content Host via TabControl (Tab headers hidden in template) -->
            <TabControl x:Name="SettingsTabControl"
                        Grid.Column="1"
                        SelectedIndex="{Binding SelectedIndex, ElementName=SettingsNavListBox, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="16,8,24,10"
                        FontFamily="{StaticResource AppFontFamily}"
                        Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </TabControl.Template>

                <!-- 1. 外观与个性化 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,4,8,12">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{DynamicResource Loc_Settings_Appearance}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="自定义系统主题色彩、显示语言、卡片尺寸及交互展现模式" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Theme Card -->
                            <ui:SettingsCard Header="{DynamicResource Loc_Settings_ThemeTitle}" 
                                             Description="{DynamicResource Loc_Settings_ThemeDesc}" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="{DynamicResource Loc_Settings_ThemeSystem}" IsChecked="{Binding Theme, Converter={StaticResource ComparisonConverter}, ConverterParameter=System}" GroupName="ThemeGroup" />
                                    <RadioButton Content="{DynamicResource Loc_Settings_ThemeLight}" IsChecked="{Binding Theme, Converter={StaticResource ComparisonConverter}, ConverterParameter=Light}" GroupName="ThemeGroup" Margin="16,0,0,0" />
                                    <RadioButton Content="{DynamicResource Loc_Settings_ThemeDark}" IsChecked="{Binding Theme, Converter={StaticResource ComparisonConverter}, ConverterParameter=Dark}" GroupName="ThemeGroup" Margin="16,0,0,0" />
                                </StackPanel>
                            </ui:SettingsCard>

                            <!-- Language Card -->
                            <ui:SettingsCard Header="{DynamicResource Loc_Settings_LanguageTitle}" 
                                             Description="{DynamicResource Loc_Settings_LanguageDesc}" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xF2B7;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                          SelectedValue="{Binding Language, Mode=TwoWay}"
                                          SelectedValuePath="Code"
                                          DisplayMemberPath="DisplayName"
                                          MinWidth="210" Height="36"
                                          VerticalAlignment="Center" />
                            </ui:SettingsCard>

                            <!-- Card Size Card -->
                            <ui:SettingsCard Header="{DynamicResource Loc_Settings_CardSizeTitle}" 
                                             Description="{DynamicResource Loc_Settings_CardSizeDesc}" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE744;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="{DynamicResource Loc_Settings_CardSmall}" IsChecked="{Binding CardSize, Converter={StaticResource ComparisonConverter}, ConverterParameter=Small}" GroupName="CardSizeGroup" />
                                    <RadioButton Content="{DynamicResource Loc_Settings_CardMedium}" IsChecked="{Binding CardSize, Converter={StaticResource ComparisonConverter}, ConverterParameter=Medium}" GroupName="CardSizeGroup" Margin="16,0,0,0" />
                                    <RadioButton Content="{DynamicResource Loc_Settings_CardLarge}" IsChecked="{Binding CardSize, Converter={StaticResource ComparisonConverter}, ConverterParameter=Large}" GroupName="CardSizeGroup" Margin="16,0,0,0" />
                                </StackPanel>
                            </ui:SettingsCard>

                            <!-- Default View Mode Card -->
                            <ui:SettingsCard Header="{DynamicResource Loc_Settings_ViewModeTitle}" 
                                             Description="{DynamicResource Loc_Settings_ViewModeDesc}" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE80A;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="{DynamicResource Loc_View_Grid}" IsChecked="{Binding ViewMode, Converter={StaticResource ComparisonConverter}, ConverterParameter=Grid}" GroupName="ViewModeGroup" />
                                    <RadioButton Content="{DynamicResource Loc_View_List}" IsChecked="{Binding ViewMode, Converter={StaticResource ComparisonConverter}, ConverterParameter=List}" GroupName="ViewModeGroup" Margin="16,0,0,0" />
                                </StackPanel>
                            </ui:SettingsCard>

                            <!-- Launch Click Mode Card -->
                            <ui:SettingsCard Header="{DynamicResource Loc_Settings_LaunchModeTitle}" 
                                             Description="{DynamicResource Loc_Settings_LaunchModeDesc}" 
                                             Margin="0,0,0,0">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE8B0;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="{DynamicResource Loc_Settings_DoubleClick}" IsChecked="{Binding LaunchClickMode, Converter={StaticResource ComparisonConverter}, ConverterParameter=DoubleClick}" GroupName="LaunchClickModeGroup" />
                                    <RadioButton Content="{DynamicResource Loc_Settings_SingleClick}" IsChecked="{Binding LaunchClickMode, Converter={StaticResource ComparisonConverter}, ConverterParameter=SingleClick}" GroupName="LaunchClickModeGroup" Margin="16,0,0,0" />
                                </StackPanel>
                            </ui:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2. 启动与托盘 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,4,8,12">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{DynamicResource Loc_Settings_Startup}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="配置系统开机自启、托盘后台常驻及窗口关闭最小化行为" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Windows Startup Card -->
                            <ui:SettingsCard Header="随 Windows 开机启动" 
                                             Description="在开机登录系统时自动启动 Portable Hub" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE7E8;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                            </ui:SettingsCard>

                            <!-- Start Minimized Card -->
                            <ui:SettingsCard Header="启动后自动最小化到系统托盘" 
                                             Description="开机静默常驻通知区，不主动弹出主窗口" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE70B;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch IsOn="{Binding StartMinimizedToTray, Mode=TwoWay}" />
                            </ui:SettingsCard>

                            <!-- Close To Tray Card -->
                            <ui:SettingsCard Header="关闭窗口 (X) 时最小化到托盘" 
                                             Description="点击右上角关闭按钮时保留后台托盘与全局快捷键" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE711;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch IsOn="{Binding CloseToTray, Mode=TwoWay}" />
                            </ui:SettingsCard>

                            <!-- Minimize To Tray Card -->
                            <ui:SettingsCard Header="最小化时隐藏任务栏图标" 
                                             Description="主窗口最小化后彻底隐藏任务栏，仅显示托盘小图标" 
                                             Margin="0,0,0,0">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE921;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch IsOn="{Binding MinimizeToTray, Mode=TwoWay}" />
                            </ui:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 3. 全局快捷键 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,4,8,12">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{DynamicResource Loc_Settings_Hotkeys}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="设置在任意应用或桌面快速呼出 Portable Hub 面板的全局热键" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Hotkey Input Card -->
                            <ui:SettingsCard Header="快速启动窗口呼出快捷键" 
                                             Description="支持直接在此按下快捷键或鼠标中键自动录入，亦可手动输入" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE765;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="HotkeyInputBox" 
                                             Text="{Binding GlobalHotkey, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="36" Width="200"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource ModernTextBox}"
                                             PreviewKeyDown="HotkeyInputBox_PreviewKeyDown"
                                             PreviewMouseDown="HotkeyInputBox_PreviewMouseDown"
                                             ToolTip="可直接在此框内按下快捷键（如 Ctrl+,）或鼠标中键/侧键自动录入，亦可手动输入" />
                                    <TextBlock Text="{Binding HotkeyStatus}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHotkeyValid}" Value="False">
                                                         <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ui:SettingsCard>

                            <!-- 快捷键呼出样式 -->
                            <ui:SettingsCard Header="{DynamicResource Loc_Settings_HotkeyOpenStyleTitle}" 
                                             Description="{DynamicResource Loc_Settings_HotkeyOpenStyleDesc}" 
                                             Margin="0,0,0,0">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE737;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="{DynamicResource Loc_Settings_HotkeyOpenStyleGrid}" IsChecked="{Binding HotkeyOpenStyle, Converter={StaticResource ComparisonConverter}, ConverterParameter=Grid}" GroupName="HotkeyOpenStyleGroup" />
                                    <RadioButton Content="{DynamicResource Loc_Settings_HotkeyOpenStyleSearch}" IsChecked="{Binding HotkeyOpenStyle, Converter={StaticResource ComparisonConverter}, ConverterParameter=Search}" GroupName="HotkeyOpenStyleGroup" Margin="16,0,0,0" />
                                </StackPanel>
                            </ui:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 4. 数据与备份 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,4,8,12">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{DynamicResource Loc_Settings_Data}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="本地软件清单、分类配置存储路径及安全备份快照管理" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Data Directory Card -->
                            <ui:SettingsCard Header="数据存储目录" 
                                             Description="{Binding DataDirectory, Mode=OneWay}" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <Button Style="{StaticResource ModernButton}" Command="{Binding OpenDataDirectoryCommand}" Height="36">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="OpenFile" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="打开目录" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </ui:SettingsCard>

                            <!-- 1. Auto Backup Frequency Card -->
                            <ui:SettingsCard Header="自动备份周期" 
                                             Description="无需联网，定期在本地自动创建数据安全快照（分类与软件记录）" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE753;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ComboBox SelectedValue="{Binding BackupFrequency, Mode=TwoWay}" SelectedValuePath="Tag" Height="36" Width="140" VerticalAlignment="Center">
                                    <ComboBoxItem Content="每周 (推荐)" Tag="Weekly" />
                                    <ComboBoxItem Content="每天" Tag="Daily" />
                                    <ComboBoxItem Content="每月" Tag="Monthly" />
                                    <ComboBoxItem Content="关闭" Tag="Off" />
                                </ComboBox>
                            </ui:SettingsCard>

                            <!-- 2. Auto Backup Retention Count Card -->
                            <ui:SettingsCard Header="备份保留上限" 
                                             Description="最多保留的本地历史备份快照数量，超出后自动覆盖最旧快照" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE74C;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding MaxBackupCount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=5, FallbackValue=5}" Height="36" Width="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Style="{StaticResource ModernTextBox}" />
                                    <TextBlock Text="份" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:SettingsCard>

                            <!-- 3. Manual Backup & Restore Card -->
                            <ui:SettingsCard Header="数据快照管理 (.phbackup)" 
                                             Description="手动创建即时数据快照文件，或从历史备份文件恢复软件库" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE898;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Foreground="#FFFFFF" Command="{Binding CreateBackupCommand}" Height="36">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Download" FontSize="18" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="立即创建" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding RestoreBackupCommand}" Margin="8,0,0,0" Height="36">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Clock" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="恢复快照..." VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard>

                            <!-- Backups List Card -->
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,0" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="现有备份记录" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Height="130">
                                        <ListBox ItemsSource="{Binding ExistingBackups}" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="6,6">
                                                        <ui:SymbolIcon Symbol="Clock" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 5. 根目录管理 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,4,8,12">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{DynamicResource Loc_Settings_Roots}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="便携软件根目录路径映射，跨驱动器与换机时保障路径自愈" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <ui:SettingsCard Header="便携软件根目录" 
                                             Description="添加 Portable 软件主文件夹，用于多盘迁移自动重连与相对路径支持" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE838;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <Button Style="{StaticResource PrimaryButton}" Foreground="#FFFFFF" Command="{Binding AddRootDirectoryCommand}" Height="36">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Add" FontSize="18" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="添加根目录" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </ui:SettingsCard>

                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,0" Padding="16,14">
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Height="220">
                                    <ListBox ItemsSource="{Binding RootDirectories}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="移除" 
                                                            Command="{Binding DataContext.DeleteRootDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}" Padding="10,4" FontSize="12" Height="32" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 6. 迁移与诊断 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,4,8,12">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{DynamicResource Loc_Settings_Diagnostics}" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="软件数据跨端迁移、运行状态排查与新版功能更新" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <ui:SettingsCard Header="JSON 数据交换" 
                                             Description="支持跨电脑、跨操作系统快速导出与导入软件清单" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE898;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding ExportJsonCommand}" Height="36">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Upload" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="导出 JSON..." VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding ImportJsonCommand}" Margin="8,0,0,0" Height="36">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Download" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="导入 JSON..." VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="故障排除与日志" 
                                             Description="查看 Serilog 运行日志与软件启动诊断信息" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xEBE8;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <Button Style="{StaticResource ModernButton}" Command="{Binding OpenLogsDirectoryCommand}" Height="36">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="OpenFile" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="打开日志文件夹" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </ui:SettingsCard>

                            <!-- Check for Updates Card -->
                            <ui:SettingsCard Header="{DynamicResource Loc_Updates_Title}" 
                                             Description="连接 GitHub Releases 检查官方最新发布版本与功能更新" 
                                             Margin="0,0,0,8">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Glyph="&#xE895;" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ui:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentAppVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding CheckForUpdatesCommand}" Height="36" IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InverseBooleanConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Sync" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{DynamicResource Loc_Updates_CheckBtn}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ui:SettingsCard>

                            <!-- Status / Result Banner -->
                            <Border Visibility="{Binding UpdateStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Foreground="#FFFFFF"
                                            Visibility="{Binding HasNewUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding OpenReleaseUrlCommand}"
                                            Height="32" Padding="12,0" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Download" FontSize="16" Foreground="#FFFFFF" Margin="0,0,6,0" />
                                            <TextBlock Text="{DynamicResource Loc_Updates_DownloadBtn}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- About App Card -->
                            <ui:SettingsCard Header="Portable Hub" 
                                             Description="轻量、现代的 Windows 便携软件启动与统一管理中心 (基于 iNKORE.UI.WPF.Modern)" 
                                             Margin="0,0,0,0">
                                <ui:SettingsCard.HeaderIcon>
                                    <Image Source="pack://application:,,,/PortableHub.App;component/Assets/app.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                </ui:SettingsCard.HeaderIcon>
                                <Button Style="{StaticResource ModernButton}" Command="{Binding OpenReleaseUrlCommand}" Height="36">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Globe" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="GitHub 开源主页" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </ui:SettingsCard>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Bottom Action Bar (Section 24: Secondary Cancel then Primary Save) -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernButton}" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" Width="80" Height="36" FontSize="14" />
                <Button Style="{StaticResource PrimaryButton}" Foreground="#FFFFFF" Command="{Binding SaveAndCloseCommand}" IsDefault="True" Width="100" Height="36" FontSize="14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Save" FontSize="18" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="保存" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

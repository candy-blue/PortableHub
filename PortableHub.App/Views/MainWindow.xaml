<Window x:Class="PortableHub.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="Portable Hub - 便携软件管理器" 
        Height="760" Width="1200"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 WinUI 3 Header / Custom TitleBar -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,0,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource BrushAccent}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE74C;" Style="{StaticResource FluentIcon}" FontSize="15" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="Portable Hub" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Search Input (WinUI 3 AutoSuggestBox) -->
                <Grid Grid.Column="1" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="TopSearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}"
                             Height="34"
                             FontSize="13"
                             Padding="30,5,10,5"
                             VerticalContentAlignment="Center" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" 
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="搜索软件、分类、标签... (Ctrl+F)" 
                               FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" 
                               VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}" />
                </Grid>

                <!-- Controls & Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Sort Selection -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource FluentIcon}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" ToolTip="排序方式" />
                        <ComboBox SelectedValue="{Binding SortBy, Mode=TwoWay}" SelectedValuePath="Tag" Width="100" Height="30" FontSize="12">
                            <ComboBoxItem Content="自定义" Tag="Custom" IsSelected="True" />
                            <ComboBoxItem Content="名称 A-Z" Tag="NameAsc" />
                            <ComboBoxItem Content="名称 Z-A" Tag="NameDesc" />
                            <ComboBoxItem Content="最近使用" Tag="RecentUsed" />
                            <ComboBoxItem Content="启动次数" Tag="LaunchCount" />
                            <ComboBoxItem Content="添加时间" Tag="CreatedAt" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Card Size Selection -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE790;" Style="{StaticResource FluentIcon}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" ToolTip="卡片大小" />
                        <ComboBox SelectedValue="{Binding CardSize, Mode=TwoWay}" SelectedValuePath="Tag" Width="72" Height="30" FontSize="12">
                            <ComboBoxItem Content="小" Tag="Small" />
                            <ComboBoxItem Content="中" Tag="Medium" IsSelected="True" />
                            <ComboBoxItem Content="大" Tag="Large" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Primary Actions -->
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSoftwareCommand}" Height="30" Padding="10,0" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="添加软件" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenScannerCommand}" Height="30" Padding="10,0" Margin="0,0,6,0" ToolTip="扫描目录自动导入">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource FluentIcon}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="扫描" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleIconButton}" Command="{Binding OpenSettingsCommand}" Width="32" Height="30" ToolTip="系统设置">
                        <TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Windows 11 Window Caption Buttons (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Style="{StaticResource SubtleIconButton}" Click="MinimizeButton_Click" Width="44" Height="52" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" Style="{StaticResource FluentIcon}" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeBtn" Style="{StaticResource SubtleIconButton}" Click="MaximizeButton_Click" Width="44" Height="52" ToolTip="最大化/还原">
                        <TextBlock Text="&#xE922;" Style="{StaticResource FluentIcon}" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource SubtleIconButton}" Click="CloseButton_Click" Width="44" Height="52" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource FluentIcon}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (Sidebar + Software Cards) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation (WinUI 3 NavigationView Style) -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSidebarBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="10,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Primary Nav (All, Favorites, Recent) -->
                        <ListBox ItemsSource="{Binding NavItems}" 
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Height="36">
                                                    <Border x:Name="NavBorder" CornerRadius="5" Background="Transparent" Padding="8,0" Cursor="Hand">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <!-- Left accent pill for selected item -->
                                                    <Border x:Name="SelectionPill" Width="3" Height="16" CornerRadius="1.5"
                                                            Background="{DynamicResource BrushAccent}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource BrushSurface}" />
                                                        <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource BrushCardHover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource FluentIcon}" FontSize="15" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="{DynamicResource BrushBadgeBg}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Separator Background="{DynamicResource BrushBorder}" Margin="6,12" Height="1" />

                        <!-- Category Header with Add Button -->
                        <Grid Margin="6,0,6,6">
                            <TextBlock Text="分类" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextTertiary}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SubtleIconButton}" Command="{Binding AddCategoryCommand}" 
                                    HorizontalAlignment="Right" Padding="5,2" ToolTip="新建分类">
                                <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" FontSize="11" />
                            </Button>
                        </Grid>

                        <!-- Categories List -->
                        <ListBox x:Name="CategoriesListBox"
                                 ItemsSource="{Binding CustomCategories}"
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 AllowDrop="True"
                                 PreviewDragOver="Category_PreviewDragOver"
                                 Drop="Category_Drop">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Height="34">
                                                    <Border x:Name="CatBorder" CornerRadius="5" Background="Transparent" Padding="8,0" Cursor="Hand">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border x:Name="CatPill" Width="3" Height="16" CornerRadius="1.5"
                                                            Background="{DynamicResource BrushAccent}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource BrushSurface}" />
                                                        <Setter TargetName="CatPill" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource BrushCardHover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="编辑分类" Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="删除分类" Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <!-- Color Indicator -->
                                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" 
                                                Background="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}" 
                                                Margin="0,0,10,0" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />

                                        <Border Grid.Column="2" Background="{DynamicResource BrushBadgeBg}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Software Cards View -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Info Bar -->
                <Border Grid.Row="0" Padding="24,14,24,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedNav.Name, FallbackValue='全部软件'}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FilteredSoftware.Count, StringFormat='({0})'}" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WinUI 3 Empty State -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding FilteredSoftware.Count, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource BrushSurface}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource FluentIcon}" FontSize="28" Foreground="{DynamicResource BrushTextTertiary}" />
                    </Border>
                    <TextBlock Text="暂无匹配的软件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="您可以直接将 .exe 文件拖入此窗口，或点击上方【添加软件】/【扫描】" 
                               FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSoftwareCommand}" 
                            HorizontalAlignment="Center" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="添加便携软件" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Software Cards List (WinUI 3 CardAction Style) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,4,16,20">
                    <ItemsControl x:Name="SoftwareCardsControl" ItemsSource="{Binding FilteredSoftware}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- WinUI 3 Card Container -->
                                <Border x:Name="CardBorder"
                                        Width="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=Width}"
                                        Height="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=Height}"
                                        Background="{DynamicResource BrushCard}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="6"
                                        Padding="12,10"
                                        Cursor="Hand"
                                        Focusable="True"
                                        Tag="{Binding}"
                                        GotFocus="Card_GotFocus"
                                        PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Card_PreviewMouseMove"
                                        Drop="Card_Drop"
                                        AllowDrop="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1.5" Opacity="0.06" Color="#000000" />
                                    </Border.Effect>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="启动" FontWeight="Bold" Command="{Binding LaunchCommand}" />
                                            <MenuItem Header="以管理员身份运行" Command="{Binding LaunchAsAdminCommand}" />
                                            <Separator />
                                            <MenuItem Header="收藏" Command="{Binding ToggleFavoriteCommand}" />
                                            <MenuItem Header="打开所在文件夹" Command="{Binding OpenFolderCommand}" />
                                            <MenuItem Header="复制软件路径" Command="{Binding CopyPathCommand}" />
                                            <Separator />
                                            <MenuItem Header="重新定位 EXE" Command="{Binding RelocateCommand}" />
                                            <MenuItem Header="编辑配置" Command="{Binding EditCommand}" />
                                            <MenuItem Header="从管理器移除" Command="{Binding DeleteCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Status Row: Running Indicator + Missing Warning + Favorite Star -->
                                        <Grid Grid.Row="0">
                                            <!-- Running Green Dot -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="运行中">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushSuccess}" />
                                            </StackPanel>

                                            <!-- Missing Warning -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource FluentIcon}" FontSize="11" Foreground="{DynamicResource BrushDanger}" Margin="0,0,3,0" />
                                                <TextBlock Text="路径失效" FontSize="10" Foreground="{DynamicResource BrushDanger}" FontWeight="Bold" />
                                            </StackPanel>

                                            <!-- Favorite Star Button (Fluent Vector Star) -->
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2"
                                                    ToolTip="收藏">
                                                <TextBlock FontSize="14" Foreground="#F59E0B">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
                                                            <Setter Property="Text" Value="&#xE735;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="False">
                                                                    <Setter Property="Text" Value="&#xE734;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextTertiary}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>

                                        <!-- Center Software Icon -->
                                        <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}}" 
                                                   Width="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=IconSize}"
                                                   Height="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=IconSize}"
                                                   Stretch="Uniform" />
                                        </Border>

                                        <!-- Software Name -->
                                        <TextBlock Grid.Row="2" Text="{Binding Name}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=FontSize}"
                                                   HorizontalAlignment="Center" 
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,4"
                                                   ToolTip="{Binding Name}" />

                                        <!-- Bottom Info: Category Pill & WinUI 3 Play Button -->
                                        <Grid Grid.Row="3" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" HorizontalAlignment="Left" Background="{DynamicResource BrushBadgeBg}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <Button Grid.Column="1" Command="{Binding LaunchCommand}"
                                                    Style="{StaticResource SubtleIconButton}" Padding="4,2"
                                                    ToolTip="启动 (或双击卡片)">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" FontSize="11" Foreground="{DynamicResource BrushAccent}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

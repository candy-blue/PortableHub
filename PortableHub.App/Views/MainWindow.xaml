<Window x:Class="PortableHub.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="Portable Hub" 
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        Height="760" Width="1200"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewDragOver="Window_PreviewDragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Reusable Software Item Context Menu (Design Doc Section 21) -->
        <ContextMenu x:Key="SoftwareItemContextMenu" Opened="SoftwareItemContextMenu_Opened">
            <MenuItem Header="{DynamicResource Loc_Action_Launch}" FontWeight="Bold" Command="{Binding LaunchCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_Action_LaunchAdmin}" Command="{Binding LaunchAsAdminCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Permissions" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Loc_Action_ToggleFavorite}" Command="{Binding ToggleFavoriteCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Favorite" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_Action_OpenFolder}" Command="{Binding OpenFolderCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Folder" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_Action_CopyPath}" Command="{Binding CopyPathCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_Action_CreateShortcut}" Command="{Binding CreateDesktopShortcutCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Download" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="MoveToCategoryMenuItem" Header="{DynamicResource Loc_Action_MoveToCategory}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Folder" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_Action_RelocateExe}" Command="{Binding RelocateCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Find" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc_Action_EditSoftware}" Command="{Binding EditCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Edit" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Loc_Action_DeleteSoftware}" Command="{Binding DeleteCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete" FontSize="16" Foreground="{DynamicResource BrushDanger}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean Modern TitleBar (Design Doc Section 132) -->
        <ui:TitleBarControl x:Name="AppTitleBar" Grid.Row="0" Title="Portable Hub" 
                            Icon="pack://application:,,,/PortableHub.App;component/Assets/app.png" 
                            IsIconVisible="True"
                            Height="36" />

        <!-- Main Workspace (Sidebar + Software Area) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation (Design Doc Section 12 & 14 - Fully Refactored Fluent Sidebar) -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="224" ClipToBounds="True"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header with Fixed-Left Collapse Toggle Button (28px Center Spine) -->
                    <Grid Grid.Row="0" Margin="0,0,0,6" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SubtleIconButton}" Command="{Binding ToggleSidebarCommand}" 
                                Width="40" Height="40" Padding="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="GlobalNavigationButton" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Nav_Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>

                    <!-- Nav Items & Custom Categories (Single Outer ScrollViewer, Zero Nested ScrollViewers) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <!-- Primary Nav (首页, 全部软件, 收藏, 最近使用) -->
                            <ListBox x:Name="NavItemsListBox"
                                     ItemsSource="{Binding NavItems}" 
                                     SelectionChanged="NavItemsListBox_SelectionChanged"
                                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
                                             <ItemsPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="40" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,4,0" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center" Margin="0,0,8,0"
                                                    Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,6" Height="1" />

                            <!-- Category Header with Add Button -->
                            <Grid Margin="10,2,6,4" Height="32" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Loc_Nav_CategoriesHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconButtonSmall}" Command="{Binding AddCategoryCommand}" 
                                        Width="28" Height="28" Padding="0" 
                                        HorizontalAlignment="Right" ToolTip="{DynamicResource Loc_Nav_AddCategory}">
                                    <ui:SymbolIcon Symbol="Add" FontSize="16" />
                                </Button>
                            </Grid>

                            <!-- Custom Categories List -->
                            <ListBox x:Name="CategoriesListBox"
                                     ItemsSource="{Binding CustomCategories}"
                                     SelectionChanged="CategoriesListBox_SelectionChanged"
                                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AllowDrop="True"
                                     PreviewDragOver="Category_PreviewDragOver"
                                     Drop="Category_Drop">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
                                            <ItemsPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="40" Background="Transparent" ClipToBounds="True"
                                              Tag="{Binding}"
                                              PreviewMouseLeftButtonDown="CategoryItem_PreviewMouseLeftButtonDown"
                                              PreviewMouseRightButtonDown="CategoryItem_PreviewMouseRightButtonDown"
                                              PreviewMouseMove="CategoryItem_PreviewMouseMove"
                                              DragOver="CategoryItem_DragOver"
                                              Drop="CategoryItem_Drop"
                                              AllowDrop="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Loc_Action_EditCategory}" Click="EditCategoryMenuItem_Click">
                                                        <MenuItem.Icon>
                                                             <ui:SymbolIcon Symbol="Edit" FontSize="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{DynamicResource Loc_Action_DeleteCategory}" Click="DeleteCategoryMenuItem_Click">
                                                        <MenuItem.Icon>
                                                             <ui:SymbolIcon Symbol="Delete" FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" FontSize="20" 
                                                           Foreground="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,4,0" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center" Margin="0,0,8,0"
                                                    Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Nav Operations (Design Doc Section 12 & 14 - Unified 40px Center Slot) -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,0">
                        <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,4" Height="1" />
                        
                        <Button Style="{StaticResource SidebarActionButtonStyle}" Command="{Binding AddSoftwareCommand}" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                                Height="40" Padding="0" Margin="0,1" Cursor="Hand" ToolTip="{DynamicResource Loc_Nav_AddSoftware}">
                            <Grid Height="40" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Add" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Nav_AddSoftware}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarActionButtonStyle}" Command="{Binding OpenScannerCommand}" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                                Height="40" Padding="0" Margin="0,1" Cursor="Hand" ToolTip="{DynamicResource Loc_Nav_ScanSoftware}">
                            <Grid Height="40" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Find" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Nav_ScanSoftware}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>

                        <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,4" Height="1" />

                        <Button Style="{StaticResource SidebarActionButtonStyle}" Command="{Binding OpenSettingsCommand}" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                                Height="40" Padding="0" Margin="0,1" Cursor="Hand" ToolTip="{DynamicResource Loc_Nav_Settings}">
                            <Grid Height="40" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Setting" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Loc_Nav_Settings}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center Software Main Area (Header -> Toolbar -> Content) (Design Doc Section 15) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Info & Action Toolbar Bar -->
                <Border Grid.Row="0" Padding="24,14,24,12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title & Count -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedNav.Name, FallbackValue='全部软件'}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding FilteredSoftware.Count, StringFormat='共 {0} 个应用'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Toolbar: Search + Sort + View Mode Switch + Add -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- SearchBox (Ctrl+F) (Design Doc Section 20 & 28) -->
                            <Grid Margin="0,0,12,0">
                                <TextBox x:Name="TopSearchBox"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="TopSearchBox_PreviewKeyDown"
                                         ui:ControlHelper.PlaceholderText="{DynamicResource Loc_Search_Placeholder}"
                                         Width="260"
                                         Height="40"
                                         FontSize="14"
                                         Padding="36,0,12,0"
                                         VerticalContentAlignment="Center" />
                                <ui:SymbolIcon Symbol="Find" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                            </Grid>

                            <!-- Sort Selection (Design Doc Section 13) -->
                            <ComboBox SelectedValue="{Binding SortBy, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="160" Width="Auto" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="{DynamicResource Loc_Sort_Custom}" Tag="Custom" />
                                <ComboBoxItem Content="{DynamicResource Loc_Sort_NameAZ}" Tag="NameAsc" />
                                <ComboBoxItem Content="{DynamicResource Loc_Sort_NameZA}" Tag="NameDesc" />
                                <ComboBoxItem Content="{DynamicResource Loc_Sort_RecentLaunch}" Tag="RecentUsed" />
                                <ComboBoxItem Content="{DynamicResource Loc_Sort_LaunchCount}" Tag="LaunchCount" />
                                <ComboBoxItem Content="{DynamicResource Loc_Sort_RecentAdd}" Tag="CreatedAt" />
                            </ComboBox>

                            <!-- View Mode Switch: Grid / List (Design Doc Section 44) -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SetGridViewCommand}" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="{DynamicResource Loc_View_Grid}" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="p" CornerRadius="4" Background="Transparent">
                                                    <ui:SymbolIcon Symbol="ViewAll" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ViewMode}" Value="Grid">
                                                        <Setter TargetName="p" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="p" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Command="{Binding SetListViewCommand}" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="{DynamicResource Loc_View_List}" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="p" CornerRadius="4" Background="Transparent">
                                                    <ui:SymbolIcon Symbol="List" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                                        <Setter TargetName="p" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="p" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Primary Add Button -->
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSoftwareCommand}" Height="40" Padding="16,0" VerticalAlignment="Center" ToolTip="{DynamicResource Loc_Nav_AddSoftware}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Loc_Nav_AddSoftware}" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Empty State (Design Doc Section 39) -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding FilteredSoftware.Count, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Folder" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_Empty_NoSoftware}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc_Empty_DragHint}" 
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,18" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSoftwareCommand}" HorizontalAlignment="Center" Height="36" Padding="16,0" FontSize="14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Loc_Nav_AddSoftware}" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Software Content Area (Grid Mode & List Mode) -->
                <Grid x:Name="SoftwareContentHost" Grid.Row="1" Visibility="{Binding FilteredSoftware.Count, Converter={StaticResource NullToVisibilityConverter}}"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ContentTranslateTransform" Y="0" />
                    </Grid.RenderTransform>
                    <!-- 1. Grid View (Design Doc Sections 16, 17, 18) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,10,18,20"
                                  Visibility="{Binding ViewMode, Converter={StaticResource ComparisonToVisibilityConverter}, ConverterParameter=Grid}">
                        <ItemsControl x:Name="SoftwareCardsControl" ItemsSource="{Binding FilteredSoftware}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Fluent ModernCard with unified CornerRadius 8 and hover micro-animations (Design Doc Section 16 & 18) -->
                                    <Border x:Name="CardActionContainer"
                                            Style="{StaticResource ModernCard}"
                                            Width="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=Width}"
                                            Height="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=Height}"
                                            Margin="6"
                                            Padding="12,10"
                                            Focusable="True"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            RenderTransformOrigin="0.5,0.5"
                                            GotFocus="Card_GotFocus"
                                            PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp"
                                            PreviewMouseMove="Card_PreviewMouseMove"
                                            MouseLeave="Card_MouseLeave"
                                            Drop="Card_Drop"
                                            AllowDrop="True"
                                            ContextMenu="{StaticResource SoftwareItemContextMenu}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Top Status Row: Running / Missing Indicator + Favorite + More ⋮ Button -->
                                            <Grid Grid.Row="0">
                                                <!-- Running Green Dot -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            ToolTip="{DynamicResource Loc_Status_Running}">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushSuccess}" />
                                                </StackPanel>

                                                <!-- Missing Warning -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ui:SymbolIcon Symbol="Important" FontSize="16" Foreground="{DynamicResource BrushDanger}" Margin="0,0,3,0" />
                                                    <TextBlock Text="{DynamicResource Loc_Status_Invalid}" FontSize="12" Foreground="{DynamicResource BrushDanger}" FontWeight="Bold" />
                                                </StackPanel>

                                                <!-- Right: Star & More Menu Buttons (Design Doc Section 18: Hover reveals ⋮ and non-favorited star) -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <!-- Favorite Star Button -->
                                                    <Button x:Name="CardFavBtn"
                                                            Style="{StaticResource SubtleIconButton}"
                                                            Command="{Binding ToggleFavoriteCommand}"
                                                            Padding="0" Width="30" Height="30"
                                                            Opacity="0"
                                                            ToolTip="{DynamicResource Loc_Action_ToggleFavorite}">
                                                        <ui:SymbolIcon x:Name="CardFavIcon" Symbol="OutlineStar" FontSize="20" Foreground="{DynamicResource BrushFavorite}" />
                                                    </Button>

                                                    <!-- More ⋮ Button (Design Doc Section 18) -->
                                                    <Button x:Name="CardMoreBtn"
                                                            Style="{StaticResource SubtleIconButton}"
                                                            Click="CardMoreButton_Click"
                                                            Padding="0" Width="30" Height="30" Margin="2,0,0,0"
                                                            Opacity="0"
                                                            ToolTip="{DynamicResource Loc_Action_More}">
                                                        <ui:SymbolIcon Symbol="More" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Center Software Icon -->
                                            <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}}" 
                                                       Width="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=IconSize}"
                                                       Height="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=IconSize}"
                                                       Stretch="Uniform" 
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       SnapsToDevicePixels="True" />
                                            </Border>

                                            <!-- Software Name -->
                                            <TextBlock Grid.Row="2" Text="{Binding Name}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=FontSize}"
                                                       HorizontalAlignment="Center" 
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,4"
                                                       ToolTip="{Binding Name}" />

                                            <!-- Bottom Info: Category Badge -->
                                            <Border Grid.Row="3" HorizontalAlignment="Center" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- More Button fade in/out on hover -->
                                        <Trigger SourceName="CardActionContainer" Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CardMoreBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CardMoreBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <!-- Non-favorite star fade in/out on hover -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=IsMouseOver, ElementName=CardActionContainer}" Value="True" />
                                                <Condition Binding="{Binding IsFavorite}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CardFavBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CardFavBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                        <!-- Favorite star always solid and fully visible -->
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter TargetName="CardFavBtn" Property="Opacity" Value="1" />
                                            <Setter TargetName="CardFavIcon" Property="Symbol" Value="SolidStar" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 2. List View (Design Doc Sections 44 & 45) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,10,20,20"
                                  Visibility="{Binding ViewMode, Converter={StaticResource ComparisonToVisibilityConverter}, ConverterParameter=List}">
                        <ItemsControl x:Name="SoftwareListControl" ItemsSource="{Binding FilteredSoftware}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModernListItem}"
                                            Margin="0,0,0,6" Padding="12,8" Cursor="Hand"
                                            Tag="{Binding}"
                                            RenderTransformOrigin="0.5,0.5"
                                            GotFocus="Card_GotFocus"
                                            PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp"
                                            PreviewMouseMove="Card_PreviewMouseMove"
                                            MouseLeave="Card_MouseLeave"
                                            Drop="Card_Drop"
                                            AllowDrop="True"
                                            ContextMenu="{StaticResource SoftwareItemContextMenu}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Software Icon (32x32) -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" 
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                                    Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}}" 
                                                       Width="28" Height="28" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       SnapsToDevicePixels="True" />
                                            </Border>

                                            <!-- Name & Path / Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <!-- Running Green Dot in List -->
                                                     <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushSuccess}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Loc_Status_Running}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ExePath}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Last Used Status -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,16,0" MinWidth="90">
                                                <TextBlock Text="{DynamicResource Loc_Sort_RecentLaunch}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding LastLaunchedDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Launch Count -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,20,0" MinWidth="60">
                                                <TextBlock Text="{DynamicResource Loc_Sort_LaunchCount}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding LaunchCount, StringFormat='{}{0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Quick Action Buttons -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Launch Button -->
                                                <Button Style="{StaticResource SubtleIconButton}" Command="{Binding LaunchCommand}" 
                                                        Padding="0" Width="32" Height="32" ToolTip="{DynamicResource Loc_Action_Launch}">
                                                    <ui:SymbolIcon Symbol="Play" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </Button>
                                                <!-- Favorite Button -->
                                                <Button Style="{StaticResource SubtleIconButton}" Command="{Binding ToggleFavoriteCommand}" 
                                                        Padding="0" Width="32" Height="32" Margin="4,0,0,0" ToolTip="{DynamicResource Loc_Action_ToggleFavorite}">
                                                    <ui:SymbolIcon x:Name="ListFavIcon" Symbol="OutlineStar" FontSize="20" Foreground="{DynamicResource BrushFavorite}" />
                                                </Button>
                                                <!-- More Button -->
                                                <Button Style="{StaticResource SubtleIconButton}" Click="CardMoreButton_Click" 
                                                        Padding="0" Width="32" Height="32" Margin="4,0,0,0" ToolTip="{DynamicResource Loc_Action_More}">
                                                    <ui:SymbolIcon Symbol="More" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter TargetName="ListFavIcon" Property="Symbol" Value="SolidStar" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Visual Drag & Drop Overlay (Design Doc Section 23) -->
        <Grid x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2" 
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.94" 
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="2" CornerRadius="12" Margin="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Download" FontSize="48" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{DynamicResource Loc_Drag_Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc_Drag_Subtitle}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

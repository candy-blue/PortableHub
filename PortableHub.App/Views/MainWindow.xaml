<ui:FluentWindow x:Class="PortableHub.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="Portable Hub" 
        Height="760" Width="1200"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Official WPF-UI TitleBar with native Windows 11 Snap Layouts & Controls -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Portable Hub" Height="48">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="AppGeneric24" FontSize="18" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.CenterContent>
                <ui:TextBox x:Name="TopSearchBox"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="搜索软件、分类、标签... (Ctrl+F)"
                            Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True"
                            Width="360"
                            Height="34"
                            Margin="12,0" />
            </ui:TitleBar.CenterContent>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- Sort Selection -->
                    <ComboBox SelectedValue="{Binding SortBy, Mode=TwoWay}" SelectedValuePath="Tag" Width="148" Height="34" Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip="排序方式">
                        <ComboBoxItem Content="自定义" Tag="Custom" IsSelected="True" />
                        <ComboBoxItem Content="名称 A-Z" Tag="NameAsc" />
                        <ComboBoxItem Content="名称 Z-A" Tag="NameDesc" />
                        <ComboBoxItem Content="最近使用" Tag="RecentUsed" />
                        <ComboBoxItem Content="启动次数" Tag="LaunchCount" />
                        <ComboBoxItem Content="添加时间" Tag="CreatedAt" />
                    </ComboBox>

                    <!-- Card Size Selection -->
                    <ComboBox SelectedValue="{Binding CardSize, Mode=TwoWay}" SelectedValuePath="Tag" Width="95" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip="卡片大小">
                        <ComboBoxItem Content="小" Tag="Small" />
                        <ComboBoxItem Content="中" Tag="Medium" IsSelected="True" />
                        <ComboBoxItem Content="大" Tag="Large" />
                    </ComboBox>

                    <!-- Primary Actions with explicit icon and text vertical centering -->
                    <ui:Button Appearance="Primary" Command="{Binding AddSoftwareCommand}" Height="34" Padding="14,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="添加软件">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="添加软件" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" Command="{Binding OpenScannerCommand}" Height="34" Padding="12,0" MinWidth="74" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0" ToolTip="扫描目录自动导入便携软件" AutomationProperties.Name="扫描">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Search24" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="扫描" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" Command="{Binding OpenSettingsCommand}" Height="34" Padding="12,0" MinWidth="74" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip="系统设置" AutomationProperties.Name="设置">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="设置" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Main Workspace (Sidebar + Software Area) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="10,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Primary Navigation Items -->
                        <ListBox ItemsSource="{Binding NavItems}" 
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Height="38">
                                                    <Border x:Name="NavBorder" CornerRadius="6" Background="Transparent" Padding="10,0" Cursor="Hand">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border x:Name="SelectionPill" Width="3" Height="16" CornerRadius="1.5"
                                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="6,12" Height="1" />

                        <!-- Category Header with Add Button -->
                        <Grid Margin="8,0,8,6">
                            <TextBlock Text="分类" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <ui:Button Appearance="Transparent" Command="{Binding AddCategoryCommand}" 
                                       Icon="{ui:SymbolIcon Add24}" Width="26" Height="26" Padding="0" 
                                       HorizontalAlignment="Right" ToolTip="新建分类" />
                        </Grid>

                        <!-- Custom Categories List -->
                        <ListBox x:Name="CategoriesListBox"
                                 ItemsSource="{Binding CustomCategories}"
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 AllowDrop="True"
                                 PreviewDragOver="Category_PreviewDragOver"
                                 Drop="Category_Drop">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid Height="36">
                                                    <Border x:Name="CatBorder" CornerRadius="6" Background="Transparent" Padding="10,0" Cursor="Hand">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border x:Name="CatPill" Width="3" Height="16" CornerRadius="1.5"
                                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        <Setter TargetName="CatPill" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CatBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0" Background="Transparent"
                                          Tag="{Binding}"
                                          PreviewMouseLeftButtonDown="CategoryItem_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="CategoryItem_PreviewMouseMove"
                                          DragOver="CategoryItem_DragOver"
                                          Drop="CategoryItem_Drop"
                                          AllowDrop="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="编辑分类" Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="删除分类" Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" FontSize="15" 
                                                       Foreground="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}" 
                                                       Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Software Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Info Bar -->
                <Border Grid.Row="0" Padding="24,14,24,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedNav.Name, FallbackValue='全部软件'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding FilteredSoftware.Count, StringFormat='({0})'}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding FilteredSoftware.Count, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="30" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Border>
                    <TextBlock Text="暂无匹配的便携软件" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="您可以直接将 .exe 拖入此窗口，或点击上方【添加软件】/【扫描】" 
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="添加便携软件" Command="{Binding AddSoftwareCommand}" HorizontalAlignment="Center" Padding="16,8" />
                </StackPanel>

                <!-- Software Cards Panel using WPF-UI CardAction -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,4,16,20">
                    <ItemsControl x:Name="SoftwareCardsControl" ItemsSource="{Binding FilteredSoftware}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Official WPF-UI CardAction with Windows 11 Depth & Hover Micro-Animation -->
                                <ui:CardAction Width="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=Width}"
                                               Height="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=Height}"
                                               IsChevronVisible="False"
                                               Margin="6"
                                               Padding="12,10"
                                               Focusable="True"
                                               Tag="{Binding}"
                                               GotFocus="Card_GotFocus"
                                               PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                               PreviewMouseMove="Card_PreviewMouseMove"
                                               Drop="Card_Drop"
                                               AllowDrop="True">
                                    <ui:CardAction.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="启动" FontWeight="Bold" Command="{Binding LaunchCommand}" />
                                            <MenuItem Header="以管理员身份运行" Command="{Binding LaunchAsAdminCommand}" />
                                            <Separator />
                                            <MenuItem Header="收藏" Command="{Binding ToggleFavoriteCommand}" />
                                            <MenuItem Header="打开所在文件夹" Command="{Binding OpenFolderCommand}" />
                                            <MenuItem Header="复制软件路径" Command="{Binding CopyPathCommand}" />
                                            <Separator />
                                            <MenuItem Header="重新定位 EXE" Command="{Binding RelocateCommand}" />
                                            <MenuItem Header="编辑配置" Command="{Binding EditCommand}" />
                                            <MenuItem Header="从管理器移除" Command="{Binding DeleteCommand}" />
                                        </ContextMenu>
                                    </ui:CardAction.ContextMenu>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Status Row: Running Indicator + Missing Warning + Favorite Star -->
                                        <Grid Grid.Row="0">
                                            <!-- Running Green Dot -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="运行中">
                                                <Ellipse Width="7" Height="7" Fill="#107C41" />
                                            </StackPanel>

                                            <!-- Missing Warning -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ui:SymbolIcon Symbol="Warning24" FontSize="12" Foreground="#C42B1C" Margin="0,0,3,0" />
                                                <TextBlock Text="失效" FontSize="10" Foreground="#C42B1C" FontWeight="Bold" />
                                            </StackPanel>

                                            <!-- Favorite Star Button (Fluent Vector Star) -->
                                            <ui:Button Appearance="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                       Command="{Binding ToggleFavoriteCommand}"
                                                       Padding="2" Width="26" Height="26"
                                                       ToolTip="收藏">
                                                <ui:SymbolIcon Symbol="Star24" Filled="{Binding IsFavorite}" FontSize="15" Foreground="#F59E0B" />
                                            </ui:Button>
                                        </Grid>

                                        <!-- Center Software Icon -->
                                        <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}}" 
                                                   Width="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=IconSize}"
                                                   Height="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=IconSize}"
                                                   Stretch="Uniform" />
                                        </Border>

                                        <!-- Software Name -->
                                        <TextBlock Grid.Row="2" Text="{Binding Name}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeToDimensionConverter}, ConverterParameter=FontSize}"
                                                   HorizontalAlignment="Center" 
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,4"
                                                   ToolTip="{Binding Name}" />

                                        <!-- Bottom Info: Category Badge & Play Button -->
                                        <Grid Grid.Row="3" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" HorizontalAlignment="Left" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <ui:Button Grid.Column="1" Appearance="Transparent" Command="{Binding LaunchCommand}"
                                                       Padding="4,2" Width="28" Height="24"
                                                       ToolTip="启动 (或双击卡片)">
                                                <ui:SymbolIcon Symbol="Play24" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </ui:Button>
                                        </Grid>
                                    </Grid>
                                </ui:CardAction>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Visual Drag & Drop Overlay -->
        <Grid x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2" 
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.94" 
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="2" CornerRadius="12" Margin="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="48" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="释放鼠标即可添加到便携软件列表" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="支持 .exe 程序、.lnk 快捷方式、批处理文件及软件目录" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>

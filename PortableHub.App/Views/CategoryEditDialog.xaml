<ui:FluentWindow x:Class="PortableHub.App.Views.CategoryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="分类管理" 
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        Height="630" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowCornerPreference="Round"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="分类管理 - Portable Hub" Height="44" FontSize="18" FontWeight="SemiBold" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/PortableHub.App;component/Assets/app.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Form ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12,24,12">
            <StackPanel>
                <!-- Real-time Preview Badge Card -->
                <ui:Card Padding="14,10" Margin="0,0,0,14" Height="58">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8" Padding="12,6"
                                MinWidth="110"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}"
                                BorderThickness="1.5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="{Binding SelectedSymbol}" FontSize="20"
                                               Foreground="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}"
                                               Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name, FallbackValue='分类预览'}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="效果实时预览" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </ui:Card>

                <!-- Category Name -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="分类名称 *" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=100}" PlaceholderText="请输入分类名称，如：常用工具、开发必备..." Height="36" />
                </StackPanel>

                <!-- Category Icon Selection from WPF-UI Symbol library -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="分类图标 (WPF-UI 官方矢量图标库)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding AvailableIconOptions}"
                             SelectedItem="{Binding SelectedIconOption, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Height="140"
                             Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="6" Background="Transparent" 
                                                    BorderThickness="1.5" BorderBrush="Transparent" Padding="4,2" Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="68" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{Binding Name}">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="20" Margin="0,3,0,1" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Category Color Selection & System Color Picker -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="分类主题色 (预设主题色与系统取色器)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    
                    <!-- Preset Color Swatches -->
                    <ItemsControl ItemsSource="{Binding AvailableColors}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,6" Width="26" Height="26"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="13" Background="{Binding Converter={StaticResource ColorHexToBrushConverter}}"
                                                    BorderThickness="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hex Code Input & ColorDialog Trigger -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" 
                                Background="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}"
                                BorderThickness="1.5" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged, Delay=100}" Width="110" Height="36" VerticalAlignment="Center" ToolTip="十六进制色值 (如 #3B82F6)" />
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Color24, FontSize=20}" Content="系统取色器" Command="{Binding OpenColorPickerCommand}" Height="36" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="打开调色板选取任意自定义色彩" />
                    </StackPanel>
                </StackPanel>

                <!-- Sort Order -->
                <StackPanel>
                    <TextBlock Text="排序序号 (数值越小越靠前，也可在左侧列表直接拖动排序)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged, Delay=100}" Width="100" Height="36" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Secondary" Content="取消" Command="{Binding CancelCommand}" Width="80" Height="36" Margin="0,0,8,0" />
                <ui:Button Appearance="Primary" Foreground="#FFFFFF" FontWeight="SemiBold" Content="保存" Command="{Binding SaveCommand}" Width="80" Height="36" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

<Window x:Class="PortableHub.App.Views.CategoryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="{DynamicResource Loc_CatDialog_Title}" 
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar (Section 24) -->
        <ui:TitleBarControl x:Name="AppTitleBar" Grid.Row="0" Title="{DynamicResource Loc_CatDialog_Title}" Height="44" FontSize="20" FontWeight="SemiBold" Icon="pack://application:,,,/PortableHub.App;component/Assets/app.png" IsIconVisible="True" />

        <!-- Form ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12,24,12">
            <StackPanel>
                <!-- Real-time Preview Badge Card -->
                <Border Style="{StaticResource ModernCard}" Padding="14,10" Margin="0,0,0,14" Height="58">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8" Padding="12,6"
                                MinWidth="110"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}"
                                BorderThickness="1.5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="{Binding SelectedSymbol}" FontSize="20"
                                               Foreground="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}"
                                               Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name, FallbackValue='分类预览'}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="效果实时预览" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Category Name -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Loc_CatDialog_NameLabel}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=100}" ui:ControlHelper.PlaceholderText="{DynamicResource Loc_CatDialog_NamePlaceholder}" Height="36" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Category Icon Selection (Dropdown Flyout Panel, pure icons without text) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Loc_CatDialog_IconLabel}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <ui:DropDownButton x:Name="IconDropDownButton" Height="36" MinWidth="160" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="{Binding SelectedSymbol}" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedIconOption.Name, TargetNullValue='选择图标'}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:DropDownButton.Flyout>
                            <ui:Flyout x:Name="IconFlyout" Placement="Bottom">
                                <Border Width="272" MaxHeight="210" Padding="6,4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AvailableIconOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="36" Height="36" Margin="3"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding Name}"
                                                            Click="IconButton_Click"
                                                            Command="{Binding DataContext.SelectIconOptionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}"
                                                            FocusVisualStyle="{x:Null}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="BtnBorder" CornerRadius="6" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
                                                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </ui:Flyout>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>

                <!-- Category Color Selection & Fluent Color Picker -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Loc_CatDialog_ColorLabel}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    
                    <!-- Preset Color Swatches -->
                    <ItemsControl ItemsSource="{Binding AvailableColors}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,6" Width="28" Height="28"
                                        Cursor="Hand"
                                        ToolTip="{Binding}"
                                        Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="14" Background="{Binding Converter={StaticResource ColorHexToBrushConverter}}"
                                                    BorderThickness="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hex Code Input & Fluent ColorPicker Trigger -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" 
                                Background="{Binding Color, Converter={StaticResource ColorHexToBrushConverter}}"
                                BorderThickness="1.5" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged, Delay=100}" Width="110" Height="36" VerticalAlignment="Center" ToolTip="十六进制色值 (如 #3B82F6)" Style="{StaticResource ModernTextBox}" />
                        <Button Style="{StaticResource ModernButton}" Command="{Binding OpenColorPickerCommand}" Height="36" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="打开高级 Fluent 调色板选取任意自定义色彩">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="FontColor" FontSize="18" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Loc_CatDialog_PickColorBtn}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Sort Order -->
                <StackPanel>
                    <TextBlock Text="排序序号 (数值越小越靠前，也可在左侧列表直接拖动排序)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged, Delay=100}" Width="100" Height="36" HorizontalAlignment="Left" Style="{StaticResource ModernTextBox}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions (Section 24: Secondary Cancel then Primary Save) -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernButton}" Content="{DynamicResource Loc_Btn_Cancel}" Command="{Binding CancelCommand}" Width="80" Height="36" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Foreground="#FFFFFF" Content="{DynamicResource Loc_Btn_Save}" Command="{Binding SaveCommand}" Width="80" Height="36" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

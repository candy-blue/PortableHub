<Window x:Class="PortableHub.App.Views.SoftwareEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="软件配置"
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        Height="650" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar (Section 24) -->
        <ui:TitleBarControl x:Name="AppTitleBar" Grid.Row="0" Title="软件配置 - Portable Hub" Height="44" FontSize="20" FontWeight="SemiBold" Icon="pack://application:,,,/PortableHub.App;component/Assets/app.png" IsIconVisible="True" />

        <!-- Form (Scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12,24,16">
            <StackPanel>
                <!-- Icon and Basic Info Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Preview & Selector -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,16,0">
                        <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}}" 
                                   Width="48" Height="48" Stretch="Uniform" />
                        </Border>
                        <Button Style="{StaticResource ModernButton}" Content="更换图标" Command="{Binding BrowseIconCommand}" 
                                FontSize="12" Padding="6,3" Margin="0,6,0,0" Height="28" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Software Name -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="软件名称 *" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="请输入软件展示名称" Height="36" Style="{StaticResource ModernTextBox}" />
                    </StackPanel>
                </Grid>

                <!-- Exe Path -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="可执行文件路径 (.exe) *" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="请选择或输入便携软件 .exe 完整路径" Height="36" Style="{StaticResource ModernTextBox}" />
                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" Command="{Binding BrowseExeCommand}" Margin="8,0,0,0" Height="36">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Folder" FontSize="18" Margin="0,0,6,0" />
                                <TextBlock Text="浏览..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Category (Section 13.2: MinWidth 140) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="所属分类 *" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}" 
                              DisplayMemberPath="Name"
                              MinWidth="140"
                              Height="36" />
                </StackPanel>

                <!-- Arguments -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="启动参数 (可选，例如: --portable --minimized)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="例如: --portable" Height="36" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Working Directory -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="工作目录 (留空默认为 EXE 所在目录)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="默认自动设为程序所在目录" Height="36" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Description -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="软件描述 / 备注" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="简短用途说明" Height="36" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Tags -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="标签 (空格分隔，例如: #搜索 #开发 #网络)" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="输入标签便于快速检索" Height="36" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Launch Options -->
                <Border Style="{StaticResource ModernCard}" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="以管理员权限运行" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding RunAsAdmin}" />
                        </Grid>
                        <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,4" Height="1" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="单实例运行 (重复打开时自动激活现有窗口)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding SingleInstance}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions (Section 24) -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernButton}" Content="取消" Command="{Binding CancelCommand}" Width="80" Height="36" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Foreground="#FFFFFF" Content="保存" Command="{Binding SaveCommand}" Width="80" Height="36" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="PortableHub.App.Views.SoftwareEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PortableHub.App.ViewModels"
        Title="{Binding IsEditMode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse, FallbackValue='添加/编辑软件'}"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="{Binding IsEditMode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse, FallbackValue='软件配置'}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Form (Scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- Icon and Basic Info Row -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Preview & Selector -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,16,0">
                        <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}}" 
                                   Width="48" Height="48" Stretch="Uniform" />
                        </Border>
                        <Button Content="更换图标" Style="{StaticResource ModernButton}" Command="{Binding BrowseIconCommand}" 
                                FontSize="11" Padding="6,3" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Software Name -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="软件名称 *" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                    </StackPanel>
                </Grid>

                <!-- Exe Path -->
                <StackPanel>
                    <TextBlock Text="可执行文件路径 (.exe) *" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        <Button Grid.Column="1" Content="浏览..." Style="{StaticResource ModernButton}" Command="{Binding BrowseExeCommand}" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Category -->
                <StackPanel>
                    <TextBlock Text="所属分类 *" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}" 
                              DisplayMemberPath="Name"
                              Padding="8,6" FontSize="13" />
                </StackPanel>

                <!-- Arguments -->
                <StackPanel>
                    <TextBlock Text="启动参数 (可选，例如: --portable --minimized)" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Working Directory -->
                <StackPanel>
                    <TextBlock Text="工作目录 (留空默认为 EXE 所在目录)" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Description -->
                <StackPanel>
                    <TextBlock Text="软件描述 / 备注" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Tags -->
                <StackPanel>
                    <TextBlock Text="标签 (空格分隔，例如: #搜索 #常用)" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <!-- Launch Options -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox Content="以管理员权限启动" IsChecked="{Binding RunAsAdmin}" 
                              Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                    <CheckBox Content="单实例运行 (重复点击激活已有窗口)" IsChecked="{Binding SingleInstance}" 
                              Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource ModernButton}" Command="{Binding CancelCommand}" Width="80" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Width="80" />
        </StackPanel>
    </Grid>
</Window>

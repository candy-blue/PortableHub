<Window x:Class="PortableHub.App.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:helpers="clr-namespace:PortableHub.App.Helpers"
        Title="Portable Hub"
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        Width="460"
        SizeToContent="Height"
        MinHeight="180"
        MaxHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBarControl x:Name="AppTitleBar" Grid.Row="0" Title="Portable Hub" Height="36" FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Icon="pack://application:,,,/PortableHub.App;component/Assets/app.png" IsIconVisible="True"
                            helpers:TitleBarHelper.RemoveCaptionButtons="True" />

        <!-- Dialog Content -->
        <Grid Grid.Row="1" Margin="24,16,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status Icon Container -->
            <Border x:Name="IconContainer" Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,16,0"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <ui:SymbolIcon x:Name="DialogSymbolIcon" Symbol="Help" FontSize="26"
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock" Text="{DynamicResource Loc_ModernDialog_ConfirmTitle}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageTextBlock" FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           LineHeight="22" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource ModernButton}" Content="{DynamicResource Loc_Btn_Cancel}"
                        Width="88" Height="36" Margin="0,0,10,0" IsCancel="True" Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc_Btn_Confirm}"
                        Width="88" Height="36" IsDefault="True" Click="ConfirmButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="PortableHub.App.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="选取分类主题色"
        Icon="pack://application:,,,/PortableHub.App;component/Assets/app.ico"
        Width="480"
        SizeToContent="Height"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Style for Fluent Preset Swatch Buttons -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="OuterBorder" CornerRadius="16" BorderThickness="2" BorderBrush="Transparent">
                                <Border x:Name="InnerBorder" CornerRadius="14" Margin="1"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBarControl x:Name="AppTitleBar" Grid.Row="0" Title="选取主题色 - Portable Hub" Height="36" FontSize="14" FontWeight="SemiBold"
                            Icon="pack://application:,,,/PortableHub.App;component/Assets/app.png" IsIconVisible="True" />

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,10,24,16">
            <StackPanel>
                <!-- 1. 2D Spectrum Canvas ("一整块"取色区域) -->
                <Grid x:Name="SpectrumContainer" Height="170" Margin="0,0,0,12" Cursor="Cross"
                      Background="Transparent" Focusable="True"
                      MouseDown="Spectrum_MouseDown"
                      MouseMove="Spectrum_MouseMove"
                      MouseUp="Spectrum_MouseUp"
                      KeyDown="Spectrum_KeyDown">
                    <!-- Layer with rounded corners containing the gradients -->
                    <Border CornerRadius="8" ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <!-- Base Hue Color -->
                            <Rectangle x:Name="SpectrumHueRect" Fill="#FF0000" />

                            <!-- Horizontal White to Transparent Gradient (Saturation 0 -> 1) -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Vertical Transparent to Black Gradient (Value 1 -> 0) -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00000000" Offset="0.0" />
                                        <GradientStop Color="#FF000000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- Interactive Target Thumb on Canvas -->
                    <Canvas ClipToBounds="False" IsHitTestVisible="False">
                        <Grid x:Name="SpectrumThumb" Width="18" Height="18" Margin="-9,-9,0,0" IsHitTestVisible="False">
                            <Ellipse Stroke="White" StrokeThickness="2" Fill="Transparent">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="14" Height="14" Stroke="#40000000" StrokeThickness="1" Fill="Transparent" />
                        </Grid>
                    </Canvas>
                </Grid>

                <!-- 2. Hue Rainbow Bar (色相条) -->
                <Grid x:Name="HueContainer" Height="22" Margin="0,0,0,14" Cursor="Hand"
                      Background="Transparent" Focusable="True"
                      MouseDown="Hue_MouseDown"
                      MouseMove="Hue_MouseMove"
                      MouseUp="Hue_MouseUp"
                      KeyDown="Hue_KeyDown">
                    <!-- Rainbow Track -->
                    <Border Height="14" CornerRadius="7" ClipToBounds="True" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF0000" Offset="0.0" />
                                <GradientStop Color="#FFFF00" Offset="0.1666" />
                                <GradientStop Color="#00FF00" Offset="0.3333" />
                                <GradientStop Color="#00FFFF" Offset="0.5" />
                                <GradientStop Color="#0000FF" Offset="0.6666" />
                                <GradientStop Color="#FF00FF" Offset="0.8333" />
                                <GradientStop Color="#FF0000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Hue Thumb on Canvas -->
                    <Canvas ClipToBounds="False" IsHitTestVisible="False">
                        <Grid x:Name="HueThumb" Width="20" Height="20" Margin="-10,0,0,0" IsHitTestVisible="False">
                            <Ellipse Fill="White" Stroke="#D1D5DB" StrokeThickness="1.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="HueThumbInner" Width="8" Height="8" Fill="#FF0000" />
                        </Grid>
                    </Canvas>
                </Grid>

                <!-- 3. Preview & Direct Hex/RGB Input Card -->
                <Border Style="{StaticResource ModernCard}" Padding="14,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Current Color Preview + HEX Input -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border x:Name="CurrentColorBorder" Width="38" Height="38" CornerRadius="19"
                                    BorderThickness="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Margin="0,0,10,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="当前颜色" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="HexInputBox" Width="88" Height="30"
                                         Style="{StaticResource ModernTextBox}"
                                         FontWeight="SemiBold" FontSize="13"
                                         VerticalContentAlignment="Center"
                                         Padding="4,0" Margin="0,2,0,0"
                                         TextChanged="HexInputBox_TextChanged" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Center: RGB Readouts -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="R" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock x:Name="RValueText" Text="59" FontSize="13" FontWeight="SemiBold" Width="28" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="G" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBlock x:Name="GValueText" Text="130" FontSize="13" FontWeight="SemiBold" Width="28" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="B" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <TextBlock x:Name="BValueText" Text="246" FontSize="13" FontWeight="SemiBold" Width="28" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right: Original Color restore -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0" HorizontalAlignment="Right">
                                <TextBlock Text="原色" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="OriginalHexText" Text="#3B82F6" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border x:Name="OriginalColorBorder" Width="32" Height="32" CornerRadius="16"
                                    BorderThickness="1.5" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Cursor="Hand" ToolTip="点击恢复原色" MouseDown="OriginalColor_MouseDown" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Preset Windows 11 Fluent Swatches -->
                <TextBlock Text="推荐主题色 (Windows 11 Fluent 调色盘)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                <WrapPanel x:Name="PresetSwatchesPanel" Orientation="Horizontal" Margin="0,0,0,4" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernButton}" Content="取消"
                        Width="84" Height="34" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="应用颜色"
                        Width="92" Height="34" IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

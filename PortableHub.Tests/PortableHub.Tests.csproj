<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO.Path" Alias="Path" />
    <Using Include="System.IO.File" Alias="File" />
    <Using Include="System.IO.Directory" Alias="Directory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortableHub.Core\PortableHub.Core.csproj" />
    <ProjectReference Include="..\PortableHub.Infrastructure\PortableHub.Infrastructure.csproj" />
    <ProjectReference Include="..\PortableHub.App\PortableHub.App.csproj" />
  </ItemGroup>

</Project>
